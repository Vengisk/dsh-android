<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:text="安装模块"
            android:textColor="?attr/colorOnBackground"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="proot + Ubuntu + deepseek-harness 一键部署"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <!-- 顶部半透明一键安装按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/install_btn"
            style="@style/Widget.DeepseekHarness.GlassButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="一键安装"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 半透明悬浮窗格：逐项状态列表 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_glass_window"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="2dp"
                android:text="组件状态"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- rootfs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/step1_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="安装状态"
                    android:src="@drawable/ic_not_installed" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/step1_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Linux 环境（rootfs）"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/step1_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="未安装"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/install_step1"
                    style="@style/Widget.DeepseekHarness.GlassButton.Item"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="安装" />
            </LinearLayout>

            <!-- 基础工具 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/step2_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="安装状态"
                    android:src="@drawable/ic_not_installed" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/step2_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="基础工具（apt）"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/step2_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="未安装"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/install_step2"
                    style="@style/Widget.DeepseekHarness.GlassButton.Item"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="安装" />
            </LinearLayout>

            <!-- Node.js -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/step3_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="安装状态"
                    android:src="@drawable/ic_not_installed" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/step3_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Node.js"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/step3_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="未安装"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/install_step3"
                    style="@style/Widget.DeepseekHarness.GlassButton.Item"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="安装" />
            </LinearLayout>

            <!-- deepseek-harness -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/step4_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="安装状态"
                    android:src="@drawable/ic_not_installed" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/step4_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="deepseek-harness"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/step4_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="未安装"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/install_step4"
                    style="@style/Widget.DeepseekHarness.GlassButton.Item"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="安装" />
            </LinearLayout>

            <!-- 全局进度 -->
            <TextView
                android:id="@+id/install_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="2dp"
                android:lineSpacingExtra="3dp"
                android:text="等待操作"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/install_progressbar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progressTint="?attr/colorPrimary"
                android:progressBackgroundTint="?attr/colorOutlineVariant"
                android:visibility="gone" />

            <TextView
                android:id="@+id/install_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/install_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="?attr/colorErrorContainer"
                android:padding="12dp"
                android:textColor="?attr/colorOnErrorContainer"
                android:textIsSelectable="true"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/install_copy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="复制报错内容"
                android:textColor="?attr/colorError"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 清除环境（危险操作） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/install_uninstall"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="清除环境（重装）"
            android:textColor="?attr/colorError" />
    </LinearLayout>
</ScrollView>