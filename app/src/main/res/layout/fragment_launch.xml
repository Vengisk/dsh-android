<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/launch_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/launch_start"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="启动"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_launch"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/launch_open"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="重启"
            android:textSize="15sp"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/launch_stop"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="停止"
            android:textSize="15sp"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/launch_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="4dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurfaceContainerLow"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/webview_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Web UI 预览区域"
            android:scaleType="center"
            android:src="@drawable/ic_launch"
            android:tint="?attr/colorSurfaceContainerHighest"
            android:visibility="visible" />

        <ImageButton
            android:id="@+id/launch_exit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|top"
            android:layout_margin="12dp"
            android:background="@drawable/bg_fullscreen_exit"
            android:contentDescription="退出全屏"
            android:elevation="6dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_fullscreen_exit"
            android:tint="?attr/colorOnSurface"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>